<Window x:Class="RimManager.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="RimManager v0.1.0" Width="1160" Height="720" MinWidth="960" MinHeight="560"
 Icon="Assets/RimManager.ico"
 Background="#F6F5EF" Foreground="#263831" FontFamily="Microsoft YaHei UI">
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="Padding" Value="10,5"/><Setter Property="Margin" Value="0,0,6,0"/>
  </Style>
  <Style TargetType="ListBoxItem">
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="5,4"/>
  </Style>
  <Style TargetType="GridSplitter">
   <Setter Property="HorizontalAlignment" Value="Stretch"/>
   <Setter Property="VerticalAlignment" Value="Stretch"/>
   <Setter Property="ResizeDirection" Value="Columns"/>
   <Setter Property="ResizeBehavior" Value="PreviousAndNext"/>
   <Setter Property="Cursor" Value="SizeWE"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="GridSplitter">
      <Border Background="Transparent">
       <Border x:Name="Grip" HorizontalAlignment="Center" Width="1" Background="#CED8CF"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Background" Value="#335448"/></Trigger>
       <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Grip" Property="Background" Value="#335448"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
 </Window.Resources>
 <DockPanel x:Name="Shell">
  <Border DockPanel.Dock="Top" Background="#243C35" Padding="16,12">
   <DockPanel LastChildFill="False">
    <TextBlock DockPanel.Dock="Left" Text="RimManager" Foreground="White" FontSize="22" FontWeight="SemiBold" Margin="0,0,16,0"/>
    <TextBlock x:Name="GameLabel" DockPanel.Dock="Left" Foreground="#D5E4D8" VerticalAlignment="Center"/>
    <Button DockPanel.Dock="Right" Content="设置" Click="Configure"/>
    <Button DockPanel.Dock="Right" Content="检查模组更新" Click="CheckUpdates"/>
    <Button DockPanel.Dock="Right" Content="重新扫描" Click="ScanAgain"/>
    <Button DockPanel.Dock="Right" Content="恢复备份" Click="RestoreBackup"/>
   </DockPanel>
  </Border>
  <Border DockPanel.Dock="Bottom" BorderBrush="#CED8CF" BorderThickness="0,1,0,0" Padding="12">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Label Content="Steam 启动参数" Target="{Binding ElementName=Arguments}"/>
    <TextBox x:Name="Arguments" Grid.Column="1" VerticalContentAlignment="Center" Margin="4,0,12,0"/>
    <Button Grid.Column="2" Content="应用配置" Click="ApplyClick"/>
    <Button x:Name="LaunchButton" Grid.Column="3" Content="启动游戏" Click="Launch" Background="#335448" Foreground="White"/>
   </Grid>
  </Border>
  <TextBlock DockPanel.Dock="Bottom" x:Name="Status" Padding="12,7" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
  <Grid Margin="12">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="23*" MinWidth="165"/>
    <ColumnDefinition Width="10"/>
    <ColumnDefinition Width="47*" MinWidth="290"/>
    <ColumnDefinition Width="10"/>
    <ColumnDefinition Width="30*" MinWidth="210"/>
   </Grid.ColumnDefinitions>
   <DockPanel>
    <TextBlock DockPanel.Dock="Top" x:Name="InactiveTitle" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8" Text="未启用模组"/>
    <TextBox DockPanel.Dock="Top" x:Name="Search" Margin="0,0,0,6" AutomationProperties.Name="搜索未启用模组" ToolTip="按名称或包标识搜索" TextChanged="FilterInactive"/>
    <ComboBox DockPanel.Dock="Top" x:Name="Kinds" Margin="0,0,0,8" AutomationProperties.Name="未启用模组类型" SelectionChanged="FilterInactive"/>
    <Button DockPanel.Dock="Bottom" Content="启用所选" Margin="0,8,0,0" Click="EnableMod"/>
    <ListBox x:Name="Inactive" SelectionChanged="ShowSelection" MouseDoubleClick="EnableMod" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
   </DockPanel>
   <GridSplitter Grid.Column="1" AutomationProperties.Name="调整未启用和已启用列表宽度"/>
   <DockPanel Grid.Column="2">
     <TextBlock DockPanel.Dock="Top" x:Name="ActiveTitle" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8" Text="已启用模组"
      ToolTip="选中模组可查看它的直接依赖连线"/>
    <TextBox DockPanel.Dock="Top" x:Name="ActiveSearch" Margin="0,0,0,8" AutomationProperties.Name="搜索已启用模组"
     ToolTip="按名称或包标识搜索" TextChanged="FilterActive"/>
    <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
     <Button Content="自动排序" Click="AutoSort"/><Button Content="停用所选" Click="DisableMod"/>
     <Button Content="导入排序" Click="ImportOrder"/><Button Content="导出排序" Click="ExportOrder"/>
    </WrapPanel>
    <Grid ClipToBounds="True">
     <ListBox x:Name="Active" Padding="53,0,0,0" AllowDrop="True" SelectionChanged="ShowSelection"
      ScrollViewer.CanContentScroll="False" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
      PreviewMouseLeftButtonDown="DragStart" PreviewMouseMove="DragMove" DragOver="DragOverRow" Drop="DropRow" DragLeave="LeaveRow"/>
     <Canvas x:Name="Wires" Width="54" HorizontalAlignment="Left" IsHitTestVisible="False"/>
    </Grid>
   </DockPanel>
   <GridSplitter Grid.Column="3" AutomationProperties.Name="调整已启用列表和模组介绍宽度"/>
   <Border Grid.Column="4" Background="#EAF0E7" Padding="14">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
     <TextBlock Text="模组介绍" FontWeight="SemiBold" FontSize="17"/>
     <TextBlock x:Name="ModName" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,12,0,4"/>
     <TextBlock x:Name="ModMeta" Foreground="#4D6359" TextWrapping="Wrap"/>
     <TextBlock x:Name="ModSummary" TextWrapping="Wrap" Margin="0,12,0,6"/>
     <Expander x:Name="More" Header="展开简介"><TextBlock x:Name="FullSummary" TextWrapping="Wrap"/></Expander>
     <WrapPanel Margin="0,10,0,0">
      <Button x:Name="PinButton" Click="ToggleLock"/><Button x:Name="WorkshopButton" Content="打开 Steam 创意工坊 ↗" Click="OpenWorkshop"/>
      <Button x:Name="KindButton" Content="修改类型" Click="ChangeKind"/>
     </WrapPanel>
     <TextBlock Text="关系说明" FontWeight="SemiBold" Margin="0,14,0,4"/>
     <TextBlock x:Name="Relations" TextWrapping="Wrap"/>
    </StackPanel></ScrollViewer>
   </Border>
  </Grid>
 </DockPanel>
</Window>
