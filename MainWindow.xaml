<Window x:Class="RimManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="RimManager v0.1.0" Width="1160" Height="720" MinWidth="960" MinHeight="560"
        Icon="Assets/RimManager.ico" Background="{DynamicResource WindowSurface}"
        Foreground="{DynamicResource Text}" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="34" GlassFrameThickness="0,42,0,0" UseAeroCaptionButtons="True"/>
    </shell:WindowChrome.WindowChrome>
    <DockPanel x:Name="Shell">
        <Border x:Name="TitleBar" DockPanel.Dock="Top" Height="42" Padding="14,0,150,0"
                Background="{DynamicResource WindowSurface}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="Assets/RimManager.png" Width="20" Height="20" Margin="0,0,9,0"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                           FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
        <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Outline}" BorderThickness="0,0,0,1" Padding="12,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock x:Name="GameLabel" Style="{StaticResource Secondary}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Border Width="1" Margin="0,5,6,5" Background="{DynamicResource Outline}"/>
                    <Button Content="设置" Tag="&#xE713;" Style="{StaticResource CommandButton}" Click="Configure"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Content="重新扫描" Tag="&#xE72C;" Style="{StaticResource CommandButton}" Click="ScanAgain"/>
                    <Button Content="检查模组更新" Tag="&#xE896;" Style="{StaticResource CommandButton}" Click="CheckUpdates"/>
                    <Button Content="恢复备份" Tag="&#xE81C;" Style="{StaticResource CommandButton}" Click="RestoreBackup"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Outline}" BorderThickness="0,1,0,0" Padding="12,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="Status" Style="{StaticResource Secondary}" VerticalAlignment="Center" Margin="0,0,12,0"
                           TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                <Label Grid.Column="1" Content="Steam 启动参数" Foreground="{DynamicResource SecondaryText}" Target="{Binding ElementName=Arguments}" VerticalAlignment="Center"/>
                <TextBox x:Name="Arguments" Grid.Column="2" Tag="可留空" Margin="4,0,8,0"/>
                <Button Grid.Column="3" Content="应用配置" Margin="0,0,8,0" Click="ApplyClick"/>
                <Button x:Name="LaunchButton" Grid.Column="4" Content="启动游戏" Tag="&#xE768;" Style="{StaticResource PrimaryButton}" Click="Launch"/>
            </Grid>
        </Border>

        <Grid Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="34*" MinWidth="250"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="34*" MinWidth="250"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="32*" MinWidth="200"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Panel}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="12,10,12,8">
                        <TextBlock x:Name="InactiveTitle" Style="{StaticResource PanelHeading}" Text="未启用模组"/>
                        <TextBox x:Name="Search" Tag="搜索未启用模组" Margin="0,8,0,6" AutomationProperties.Name="搜索未启用模组"
                                 ToolTip="按名称或包标识搜索" TextChanged="FilterInactive"/>
                        <ComboBox x:Name="Kinds" AutomationProperties.Name="未启用模组类型" SelectionChanged="FilterInactive"/>
                    </StackPanel>
                    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Outline}" BorderThickness="0,1,0,1" Padding="12,6">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="类型" Style="{StaticResource Secondary}"/>
                            <TextBlock Text="模组" Style="{StaticResource Secondary}"/>
                        </DockPanel>
                    </Border>
                    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Outline}" BorderThickness="0,1,0,0" Padding="10,8">
                        <Button Content="启用所选" Tag="&#xE710;" HorizontalAlignment="Left" Click="EnableMod"/>
                    </Border>
                    <ListBox x:Name="Inactive" Padding="5,4,0,4" SelectionChanged="ShowSelection"
                             MouseDoubleClick="EnableMod" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                </DockPanel>
            </Border>
            <GridSplitter Grid.Column="1" AutomationProperties.Name="调整未启用和已启用列表宽度"/>
            <Border Grid.Column="2" Style="{StaticResource Panel}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="12,10,12,8">
                        <TextBlock x:Name="ActiveTitle" Style="{StaticResource PanelHeading}" Text="已启用模组"
                                   ToolTip="选中模组可查看它的直接依赖连线"/>
                        <TextBox x:Name="ActiveSearch" Tag="搜索已启用模组" Margin="0,8,0,0"
                                 AutomationProperties.Name="搜索已启用模组" ToolTip="按名称或包标识搜索" TextChanged="FilterActive"/>
                    </StackPanel>
                    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Outline}" BorderThickness="0,1,0,1" Padding="62,6,12,6">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="类型" Style="{StaticResource Secondary}"/>
                            <TextBlock Text="加载顺序 · 模组" Style="{StaticResource Secondary}"/>
                        </DockPanel>
                    </Border>
                    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Outline}" BorderThickness="0,1,0,0" Padding="10,6">
                        <WrapPanel>
                            <Button Content="停用所选" Click="DisableMod" Margin="0,2,5,2"/>
                            <Button Content="自动排序" Click="AutoSort" Margin="0,2,5,2"/>
                            <Button Content="导入排序" Click="ImportOrder" Margin="0,2,5,2"/>
                            <Button Content="导出排序" Click="ExportOrder" Margin="0,2,0,2"/>
                        </WrapPanel>
                    </Border>
                    <Grid ClipToBounds="True">
                        <ListBox x:Name="Active" Padding="53,4,0,4" AllowDrop="True" SelectionChanged="ShowSelection"
                                 ScrollViewer.CanContentScroll="False" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 PreviewMouseLeftButtonDown="DragStart" PreviewMouseMove="DragMove" DragOver="DragOverRow" Drop="DropRow" DragLeave="LeaveRow"/>
                        <Canvas x:Name="Wires" Width="54" HorizontalAlignment="Left" IsHitTestVisible="False"/>
                    </Grid>
                </DockPanel>
            </Border>
            <GridSplitter Grid.Column="3" AutomationProperties.Name="调整已启用列表和模组介绍宽度"/>
            <Border Grid.Column="4" Style="{StaticResource Panel}" Padding="12,10,10,10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="模组介绍" Style="{StaticResource PanelHeading}" Margin="0,0,0,12"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,4,0">
                            <DockPanel>
                                <Border x:Name="ModTile" DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="8"
                                        Background="{DynamicResource SelectedSurface}" VerticalAlignment="Top" Margin="0,0,9,0">
                                    <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                               Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel>
                                    <TextBlock x:Name="ModName" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="ModMeta" Style="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DockPanel>
                            <TextBlock x:Name="ModSummary" TextWrapping="Wrap" Margin="0,12,0,6"/>
                            <Expander x:Name="More" Header="展开简介"><TextBlock x:Name="FullSummary" TextWrapping="Wrap"/></Expander>
                            <WrapPanel Margin="0,7,0,0">
                                <Button x:Name="PinButton" Tag="&#xE72E;" Click="ToggleLock" Margin="0,2,5,2"/>
                                <Button x:Name="WorkshopButton" Content="创意工坊 ↗" Click="OpenWorkshop" Margin="0,2,5,2"/>
                                <Button x:Name="KindButton" Content="修改类型" Click="ChangeKind" Margin="0,2,0,2"/>
                            </WrapPanel>
                            <Border BorderBrush="{DynamicResource Outline}" BorderThickness="0,1,0,0" Margin="0,13,0,0" Padding="0,11,0,0">
                                <StackPanel>
                                    <TextBlock Text="依赖关系" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="Relations" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
